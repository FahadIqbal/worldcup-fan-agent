{
  "name": "worldcup-fan-agent",
  "version": "1.0.0",
  "description": "AI-powered travel & logistics agent for the 2026 FIFA World Cup fans",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "psql $NEON_DATABASE_URL -f db/migrate.sql",
    "db:reset": "psql $NEON_DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:migrate",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.1.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@neondatabase/serverless": "^0.9.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.2.0",
    "next": "14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.4",
    "jest": "^29.7.0",
    "typescript": "^5.5.2"
  }
}
